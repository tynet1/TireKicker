# Copy to .env and fill in. Never commit .env.

# --- How the app runs ---
# Uncomment to run the prebuilt release image (ghcr.io/tynet1/tirekicker) instead of building from source.
# On Windows, separate the two files with ; instead of :. TIREKICKER_VERSION overrides the image the checked-out
# release pins (leave it unset normally). See docs/DEPLOY.md §2 and §6.
#COMPOSE_FILE=docker-compose.yml:compose.release.yml
#TIREKICKER_VERSION=

# --- Database (used by the db and app containers) ---
POSTGRES_USER=gc
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=gc_inspections

# --- First admin account (created on first start if no admin exists) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars

# --- Web ---
# The hostname people type. Caddy uses it to pick TLS:
#   :80                      plain HTTP (use this behind Cloudflare Tunnel, or for a quick LAN test)
#   inspect.example.com      Caddy gets a Let's Encrypt cert (needs ports 80/443 open to the internet)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# "auto" marks the sign-in cookie Secure when the request came in over HTTPS.
COOKIE_SECURE=auto
# Photo limits: per person per 24 hours, and the free disk space below which uploads wait on the phones.
# Leave blank for the defaults (1024 MB a day, pause under 2048 MB free).
UPLOAD_DAILY_MB=
UPLOAD_MIN_FREE_MB=
# Your local time zone (PDF and CSV dates use it). Defaults to UTC if blank.
TZ=America/Chicago

# --- Cloudflare Tunnel (optional; start with: docker compose --profile tunnel up -d) ---
# Create a tunnel in the Cloudflare Zero Trust dashboard, point its public hostname at http://caddy:80,
# and paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups ---
# Host folder for nightly backups. Point it at a second disk or a mounted NAS share.
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
